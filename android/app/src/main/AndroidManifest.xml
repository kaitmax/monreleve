<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AN4 increment 1: the client talks to /api/v1 over the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      AN-FIX F2/F6 (R304): NO LOCATION PERMISSION IN THE RELEASE BUILD UNTIL DETECTION SHIPS.
      The manual product declares no location permission - asking for one claims a feature this
      build does not expose (R282), and it is the single item most likely to draw Play review. The
      on-device detection code and the bundled border polygon STAY in the repository (dormant), but
      ACCESS_FINE_LOCATION now lives in src/debug/AndroidManifest.xml, so only the detection-capable
      builds (debug/audit, and the build AN6b's field testers install) carry it. The BUILT release
      APK is asserted to declare no location permission by the checkReleaseNoLocationPermission gate
      task (read from the APK with aapt2, not from source). When detection ships (AN6+), the
      permission and the data-safety-form entry move with it. PARKAN-32.
    -->


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MonReleve">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MonReleve">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          AN4 increment 4 (SPEC 10, R195). The App Link callback target. exported
          is required for an App Link; singleTop so a warm delivery reaches
          onNewIntent, which re-validates. autoVerify asks the OS to verify the
          domain against /.well-known/assetlinks.json - which cannot succeed until
          monreleve.ch resolves and serves the fingerprints (PARK4-2 / PARKAN-1):
          this task proves the app's HANDLING of the intent, NOT the OS's
          verification. The path is the frozen contract shape exactly.
        -->
        <activity
            android:name=".CallbackActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MonReleve">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="monreleve.ch"
                    android:path="/api/v1/auth/callback" />
            </intent-filter>
        </activity>
        <!--
          AN14a F1. The four dev.* activities (GalleryActivity, SignInProbeActivity, DevRecorderActivity,
          DetectionReplayActivity) MOVED to src/debug/AndroidManifest.xml. The AN-AUDIT found them exported
          in the RELEASE APK - a launchable developer-tooling attack surface a user's install must not
          carry (F1). Their declarations now live only in the debug fragment, so the debug and audit
          variants keep them (the walkthrough drivers reach them by name) and release declares none. Their
          Kotlin is left in src/main/kotlin/ch/monreleve/app/dev (it compiles into every variant), but with
          no manifest root in release it is unreferenced there and R8 strips it once minification is on
          (AN14a increment 2). checkReleaseNoDevComponent reads the BUILT release APK and fails on any
          ch.monreleve.app.dev.* component (AC2/R249). See src/debug/AndroidManifest.xml for the declarations.
        -->

        <!--
          AN11: the FileProvider for exporting the Releve (AC2 / R136). The PDF/CSV is written to the private
          cache and shared as a content URI with a per-share read grant - no storage permission, nothing but
          the exports/ subfolder exposed (res/xml/file_paths.xml). Authority is ${applicationId}.fileprovider,
          which the code reads back as "${context.packageName}.fileprovider".
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>

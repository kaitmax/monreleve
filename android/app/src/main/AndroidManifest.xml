<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- AN4 increment 1: the client talks to /api/v1 over the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      AN-AUTO (R316, REVERSES R304): DETECTION SHIPS, SO THE LOCATION PERMISSION RETURNS TO THE RELEASE
      BUILD. Automatic detection is opt-in and labelled beta (R315), but the feature now EXISTS in the
      release, so the permission it needs is declared here in src/main (every variant), not hidden in
      src/debug. The set is EXACTLY what background, coordinate-free detection needs and nothing more:
        - ACCESS_FINE_LOCATION:       the 150 m border buffer needs precise fixes (D25); COARSE cannot
                                      place a point relative to the border, so it is deliberately NOT
                                      declared.
        - ACCESS_BACKGROUND_LOCATION: sampling runs during the working window while the app is closed
                                      (SPEC 13.1); on Android 10+ this is a SEPARATE runtime grant,
                                      requested after FINE (D5 warns of the two dialogs).
      No FOREGROUND_SERVICE: the sampler is WorkManager periodic work + a single fix, not a foreground
      service, so no persistent notification and no service permission (SPEC 13.1's spike choice).
      The coordinate is classified on-device and DISCARDED (D18) - never stored, logged or sent; the
      restricted permission does not change that (Data Safety stays Case 1, local-only). The BUILT
      release APK is asserted to declare EXACTLY {FINE, BACKGROUND} and nothing more by the
      checkReleaseLocationPermissions gate task (read from the APK with aapt2, not from source).
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!--
      R323 / PARKAN-36 (AN-NEXT). The evening proposal notification is a LOCAL notification (no server, no FCM).
      POST_NOTIFICATIONS is the Android 13+ (API 33) runtime permission to post one; on API 26-32 (the S9 is 29)
      it does not exist and posting needs no grant. It is OPT-IN and asked only when the person turns the evening
      notification on (MainActivity), never at launch - the same disclosure-first discipline as detection.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MonReleve">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MonReleve">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          AN4 increment 4 (SPEC 10, R195). The App Link callback target. exported
          is required for an App Link; singleTop so a warm delivery reaches
          onNewIntent, which re-validates. autoVerify asks the OS to verify the
          domain against /.well-known/assetlinks.json - which cannot succeed until
          monreleve.ch resolves and serves the fingerprints (PARK4-2 / PARKAN-1):
          this task proves the app's HANDLING of the intent, NOT the OS's
          verification. The path is the frozen contract shape exactly.
        -->
        <activity
            android:name=".CallbackActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MonReleve">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="monreleve.ch"
                    android:path="/api/v1/auth/callback" />
            </intent-filter>
        </activity>
        <!--
          AN14a F1. The four dev.* activities (GalleryActivity, SignInProbeActivity, DevRecorderActivity,
          DetectionReplayActivity) MOVED to src/debug/AndroidManifest.xml. The AN-AUDIT found them exported
          in the RELEASE APK - a launchable developer-tooling attack surface a user's install must not
          carry (F1). Their declarations now live only in the debug fragment, so the debug and audit
          variants keep them (the walkthrough drivers reach them by name) and release declares none. Their
          Kotlin is left in src/main/kotlin/ch/monreleve/app/dev (it compiles into every variant), but with
          no manifest root in release it is unreferenced there and R8 strips it once minification is on
          (AN14a increment 2). checkReleaseNoDevComponent reads the BUILT release APK and fails on any
          ch.monreleve.app.dev.* component (AC2/R249). See src/debug/AndroidManifest.xml for the declarations.
        -->

        <!--
          AN-NOTIF (R339). The evening notification's RECORDING RECEIVER. A recording button fires an IMMUTABLE
          broadcast PendingIntent to this receiver, which records the day through the one repository path (R206)
          and turns the notification into a confirmation. It is a PRODUCTION component (it records days), so it
          ships in every variant - unlike the dev.* tooling (checkReleaseNoDevComponent), this one belongs in
          release. exported="false": only the app's OWN PendingIntents target it; nothing outside the app can
          reach it (android-intent-security). D16 holds - a clearly labelled button tap IS the person's tap.
        -->
        <receiver
            android:name=".notification.EveningActionReceiver"
            android:exported="false" />

        <!--
          AN-MANUAL-REMINDER (R1140). The 19:00 fallback reminder's RE-PLAN receiver: a time-zone or clock change
          re-aims the pending WorkManager request at the new 19:00 local; a reboot re-plans from the zone in force
          (catching up an evening whose 19:00 passed while the phone was off).
          System broadcasts only, exempt from Android 8's implicit-broadcast limits. exported="false" - the system
          delivers its own broadcasts to it (as to WorkManager's RescheduleReceiver); no other app can reach it.
          RECEIVE_BOOT_COMPLETED is already declared by WorkManager's manifest: no permission is added.
        -->
        <receiver
            android:name=".reminder.FallbackReminderReplanReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!--
          AN11: the FileProvider for exporting the Releve (AC2 / R136). The PDF/CSV is written to the private
          cache and shared as a content URI with a per-share read grant - no storage permission, nothing but
          the exports/ subfolder exposed (res/xml/file_paths.xml). Authority is ${applicationId}.fileprovider,
          which the code reads back as "${context.packageName}.fileprovider".
        -->
        <!-- IOS-1b-A R603: Compose Multiplatform resources' context provider. Android draws its glyphs from its own
             drawables (shared design/Glyph.kt), so nothing reads a Compose resource here and the provider is removed
             rather than started at every launch. -->
        <provider
            android:name="org.jetbrains.compose.resources.AndroidContextProvider"
            android:authorities="${applicationId}.resources.AndroidContextProvider"
            tools:node="remove" />
        <!--
          AN-FCM-CLIENT (R1150). THE FIREBASE CLOUD MESSAGING CLIENT, AND NOTHING ELSE FIREBASE DOES BY ITSELF.
          - FirebaseInitProvider is REMOVED: there is no google-services.json, and FirebaseApp is built from
            FirebaseOptions only when the four FCM_ANDROID_* build values exist (push/PushRuntime.kt). Unset, no
            Firebase code runs at launch and the app behaves as it did before this task.
          - Auto-init OFF: no registration token is generated until the app asks, which it does only for a
            signed-in person with the notification permission (push/PushRegistration.kt).
          - Analytics and delivery-metrics collection OFF. No analytics or crash SDK is in the build (SPEC D32,
            and "no third-party SDK beyond FCM"); these flags hold the line even if a transitive library ever looks for them.
          checkReleasePushManifest reads these back from the BUILT release APK (R249).
        -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="true" />
        <meta-data
            android:name="delivery_metrics_exported_to_big_query_enabled"
            android:value="false" />

        <!--
          AN-FCM-CLIENT (R1151, R1152). The app's FirebaseMessagingService: a data-only daily reminder becomes the
          EXISTING evening notification (R339) or nothing; a token refresh re-registers. exported="false" - FCM's
          own receiver (FirebaseInstanceIdReceiver, permission-guarded by c2dm SEND) hands messages to it.
        -->
        <service
            android:name=".push.MonRelevePushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>

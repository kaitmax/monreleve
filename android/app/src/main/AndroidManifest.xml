<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AN4 increment 1: the client talks to /api/v1 over the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      AN6a increment 5: on-device detection reads GPS fixes, classifies them against the
      bundled polygon, and DISCARDS the coordinate (D18) - it is never stored, logged or sent.
      FINE (foreground) only here; ACCESS_BACKGROUND_LOCATION (Play's restricted permission) is
      an AN7 decision with the background-sampling spike, not requested yet.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MonReleve">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MonReleve">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          AN4 increment 4 (SPEC 10, R195). The App Link callback target. exported
          is required for an App Link; singleTop so a warm delivery reaches
          onNewIntent, which re-validates. autoVerify asks the OS to verify the
          domain against /.well-known/assetlinks.json - which cannot succeed until
          monreleve.ch resolves and serves the fingerprints (PARK4-2 / PARKAN-1):
          this task proves the app's HANDLING of the intent, NOT the OS's
          verification. The path is the frozen contract shape exactly.
        -->
        <activity
            android:name=".CallbackActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MonReleve">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="monreleve.ch"
                    android:path="/api/v1/auth/callback" />
            </intent-filter>
        </activity>
        <!--
          AN3 increment 6. The AC3 instrument (dev/GalleryScreen.kt). No
          intent-filter - never appears in the launcher, never a SPEC 11
          screen. Reached only by naming the component directly:
            adb shell am start -n ch.monreleve.app/ch.monreleve.app.dev.GalleryActivity
          See GalleryActivity.kt's own header for why it is exported.
        -->
        <activity
            android:name=".dev.GalleryActivity"
            android:exported="true"
            android:theme="@style/Theme.MonReleve" />

        <!--
          AN4 increment 6. The AC1 walkthrough instrument (dev/SignInProbeActivity):
          drives SessionManager against pnpm dev after sign-in. No intent-filter,
          never in the launcher. Reached only by:
            adb shell am start -n ch.monreleve.app/ch.monreleve.app.dev.SignInProbeActivity
          exported for that adb reach; it holds no data and reads the session the
          real callback already stored.
        -->
        <activity
            android:name=".dev.SignInProbeActivity"
            android:exported="true"
            android:theme="@style/Theme.MonReleve" />

        <!--
          AN5 increment 5. The dev recorder (dev/DevRecorderActivity): records a day
          through EntryRepository and shows its pending/synced state, so the AN5
          walkthrough can drive a real write against the production container. No
          intent-filter, never in the launcher. Reached only by:
            adb shell am start -n ch.monreleve.app/ch.monreleve.app.dev.DevRecorderActivity
          exported for that adb reach, the same status as the gallery and the probe.
        -->
        <activity
            android:name=".dev.DevRecorderActivity"
            android:exported="true"
            android:theme="@style/Theme.MonReleve" />

        <!--
          AN6a increment 5. The detection replay (dev/DetectionReplayActivity): runs the seven
          synthetic tracks through the real pipeline and shows the live geo-fix classification.
          No intent-filter, never in the launcher. Reached only by:
            adb shell am start -n ch.monreleve.app/ch.monreleve.app.dev.DetectionReplayActivity
          exported for that adb reach, the same status as the gallery, the probe and the recorder.
        -->
        <activity
            android:name=".dev.DetectionReplayActivity"
            android:exported="true"
            android:theme="@style/Theme.MonReleve" />

        <!--
          AN11: the FileProvider for exporting the Releve (AC2 / R136). The PDF/CSV is written to the private
          cache and shared as a content URI with a per-share read grant - no storage permission, nothing but
          the exports/ subfolder exposed (res/xml/file_paths.xml). Authority is ${applicationId}.fileprovider,
          which the code reads back as "${context.packageName}.fileprovider".
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>

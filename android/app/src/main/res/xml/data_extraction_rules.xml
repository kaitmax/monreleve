<?xml version="1.0" encoding="utf-8"?>
<!--
  AN4 increment 2. android:dataExtractionRules, for API 31+ (backup_rules.xml
  covers 26-30). The token SharedPreferences is excluded from BOTH a cloud backup
  AND a device-to-device transfer - the relay's "a restored backup must not
  resurrect a session" applies to both channels, and device-transfer is the one
  fullBackupContent could never express.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="monreleve.auth.xml" />
        <exclude domain="sharedpref" path="monreleve.pending.xml" />
        <!-- AN-FIX F4 / R303: the account scope, excluded from both channels like the token. -->
        <exclude domain="sharedpref" path="monreleve.account.xml" />
        <!-- AN-FCM-CLIENT (R1153): a restored "push available" record would silence the 19:00 fallback on a new
             phone that never registered; FCM's own token store belongs to the old install. -->
        <exclude domain="sharedpref" path="monreleve.push.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="monreleve.auth.xml" />
        <exclude domain="sharedpref" path="monreleve.pending.xml" />
        <exclude domain="sharedpref" path="monreleve.account.xml" />
        <!-- AN-FCM-CLIENT (R1153): a restored "push available" record would silence the 19:00 fallback on a new
             phone that never registered; FCM's own token store belongs to the old install. -->
        <exclude domain="sharedpref" path="monreleve.push.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
    </device-transfer>
</data-extraction-rules>

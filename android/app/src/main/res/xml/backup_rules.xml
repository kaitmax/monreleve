<?xml version="1.0" encoding="utf-8"?>
<!--
  AN4 increment 2. android:fullBackupContent, the backup rules for API 26-30
  (dataExtractionRules below covers 31+; BOTH are needed because minSdk is 26).
  The token SharedPreferences (monreleve.auth -> shared_prefs/monreleve.auth.xml)
  is EXCLUDED, so a restored backup does not resurrect a session. The Keystore
  key is device-bound and never leaves the device anyway; excluding the ciphertext
  is the explicit second guarantee.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="monreleve.auth.xml" />
    <exclude domain="sharedpref" path="monreleve.pending.xml" />
    <!-- AN-FIX F4 / R303: the account scope (an opaque tag of the address), excluded so a restored backup
         carries no account identity; a restore lands on sign-in, and the fix scopes any restored rows. -->
    <exclude domain="sharedpref" path="monreleve.account.xml" />
    <!-- AN-FCM-CLIENT (R1153): a restored "push available" record would silence the 19:00 fallback on a new
         phone that never registered; FCM's own token store belongs to the old install. -->
    <exclude domain="sharedpref" path="monreleve.push.xml" />
    <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
</full-backup-content>

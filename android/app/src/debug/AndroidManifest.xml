<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY manifest fragment (R284). It declares the session-injection activity into the DEBUG
  variant only; the manifest merger never adds it to a release build because src/debug is not part of
  the release variant. checkReleaseNoDebugInjection reads the MERGED RELEASE manifest and fails if the
  activity ever appears there anyway (a library, a stray main-manifest entry) - the guard that makes
  "debug-only" a checked fact rather than a claim, mirroring checkReleaseCleartext.

  exported="true" so `adb shell am start -n` can reach it; no intent-filter, so it is never in the
  launcher and no App Link opens it. It is consumed in-app and never forwarded (android-intent-security).

  DebugSeederActivity (AN-AUDIT increment 1) joins it here on the same terms: the deterministic dataset
  generator, declared ONLY in this debug fragment so the merger never adds it to a release build.
  checkReleaseNoDebugInjection names "DebugSeeder" alongside "SessionInjection" and fails if either reaches
  the merged release manifest.

  AN-AUDIT increment 2: the `audit` build type REUSES this fragment (build.gradle.kts sourceSets), so both
  activities also appear in the audit APK - the release configuration made runnable against the local server.
  The audit variant is NOT a release build; checkReleaseNoDebugInjection still proves both are absent from the
  RELEASE variant, which is the only one that ships.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      AN-AUTO (R316, REVERSES R304): the location permission MOVED BACK to src/main. Detection now ships
      in the release (opt-in, beta), so FINE + ACCESS_BACKGROUND_LOCATION are declared once in
      src/main/AndroidManifest.xml (every variant), not here. This fragment no longer declares any
      location permission; the debug/audit variants inherit the main set like release does. The built
      release APK is asserted to declare EXACTLY {FINE, BACKGROUND} by checkReleaseLocationPermissions.
    -->

    <application>
        <activity
            android:name=".debug.SessionInjectionActivity"
            android:exported="true"
            android:theme="@style/Theme.MonReleve" />
        <activity
            android:name=".debug.DebugSeederActivity"
            android:exported="true"
            android:theme="@style/Theme.MonReleve" />

        <!--
          AN14a F1. The four dev.* activities MOVED here from src/main/AndroidManifest.xml. The AN-AUDIT
          found them exported in the RELEASE APK (F1) - a launchable developer-tooling attack surface. They
          are declared ONLY in this debug fragment now, so the manifest merger never adds them to a release
          build, while the debug and audit variants (the audit variant reuses this fragment) keep them for
          the walkthrough drivers. checkReleaseNoDevComponent reads the BUILT release APK and fails if any
          ch.monreleve.app.dev.* component reaches it (AC2/R249). Their Kotlin stays in src/main/kotlin; with
          a manifest root only here, R8 strips it from the release variant once minification is on (AN14a
          increment 2). Each has no intent-filter - never in the launcher, reached only by `adb shell am
          start -n ch.monreleve.app/ch.monreleve.app.dev.<Name>`, exported for that adb reach.

          GalleryActivity       - AN3 increment 6, the component gallery (dev/GalleryScreen.kt).
          SignInProbeActivity   - AN4 increment 6, drives SessionManager against pnpm dev after sign-in.
          DevRecorderActivity   - AN5 increment 5, records a day through EntryRepository, shows pending/synced.
          DetectionReplayActivity - AN6a increment 5, replays the synthetic tracks through the real pipeline.
        -->
        <activity
            android:name=".dev.GalleryActivity"
            android:exported="true"
            android:theme="@style/Theme.MonReleve" />
        <activity
            android:name=".dev.SignInProbeActivity"
            android:exported="true"
            android:theme="@style/Theme.MonReleve" />
        <activity
            android:name=".dev.DevRecorderActivity"
            android:exported="true"
            android:theme="@style/Theme.MonReleve" />
        <activity
            android:name=".dev.DetectionReplayActivity"
            android:exported="true"
            android:theme="@style/Theme.MonReleve" />
        <!--
          AN-AUTO increment 7: DetectionMockReplayActivity replays the seven synthetic tracks through the REAL
          background path on the PHYSICAL phone, via a debug-only test location provider (A3). Declared only here,
          so it never ships; checkReleaseNoDevComponent fails on any ch.monreleve.app.dev.* in the release APK.
          Reached by: adb shell am start -n ch.monreleve.app/ch.monreleve.app.dev.DetectionMockReplayActivity
        -->
        <activity
            android:name=".dev.DetectionMockReplayActivity"
            android:exported="true"
            android:theme="@style/Theme.MonReleve" />

        <!--
          AN14a increment 4 - R307 runtime half. WireDumpActivity serialises a fixture covering every enum
          value through the real (minified, in the audit variant) EntriesWire and logs the JSON. Declared
          only here, so it never ships (checkReleaseNoDevComponent). Reached by:
            adb shell am start -n ch.monreleve.app/ch.monreleve.app.dev.WireDumpActivity
        -->
        <activity
            android:name=".dev.WireDumpActivity"
            android:exported="true"
            android:theme="@style/Theme.MonReleve" />

        <!--
          AN-NEXT increment 3 (R323). EveningNotifyActivity runs the REAL evening-notification path
          (maybeNotifyEvening) on demand, so the proposal notification can be seen on the physical phone
          without the WorkManager wake and a real weekday evening. Declared only here, so it never ships
          (checkReleaseNoDevComponent fails on any ch.monreleve.app.dev.* in the release APK). Reached by:
            adb shell am start -n ch.monreleve.app/ch.monreleve.app.dev.EveningNotifyActivity
        -->
        <activity
            android:name=".dev.EveningNotifyActivity"
            android:exported="true"
            android:theme="@style/Theme.MonReleve" />

        <!--
          AN-ALERT. ThresholdAlertActivity runs the REAL threshold-alert path (maybeAlertThreshold) on demand,
          so each WHEN case (first crossing, staying crossed, fall-back-then-re-cross, the same-day merge,
          opt-out) can be produced on the physical phone without a background wake. Declared only here, so it
          never ships (checkReleaseNoDevComponent fails on any ch.monreleve.app.dev.* in the release APK).
          Reached by: adb shell am start -n ch.monreleve.app/ch.monreleve.app.dev.ThresholdAlertActivity
        -->
        <activity
            android:name=".dev.ThresholdAlertActivity"
            android:exported="true"
            android:theme="@style/Theme.MonReleve" />
    </application>
</manifest>

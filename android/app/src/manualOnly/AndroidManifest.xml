<?xml version="1.0" encoding="utf-8"?>
<!--
  AN-PLAY-PACK (R1124). THE MANUAL-ONLY FALLBACK'S MANIFEST OVERLAY - merged into every variant ONLY when the build is
  made with -PmanualOnly=true (android/app/build.gradle.kts), and never otherwise. It REMOVES the two location
  permissions src/main declares for detection and adds nothing: the release Play would take if it refuses
  ACCESS_BACKGROUND_LOCATION (docs/play-background-location.md, docs/play-release.md section 4). The app reads
  "detection available" from the permissions its package requests (detection/DetectionAvailability.kt), so without
  these two it shows no detection entry point. ManualOnlyOverlayTest keeps this list equal to src/main's location set;
  checkReleaseLocationPermissions and checkReleaseBundle assert the BUILT set is empty for this variant.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        tools:node="remove" />

</manifest>

# Copy to .env for local work. docker compose up -d starts the database
# these credentials belong to; they are local-only and not secret.
DATABASE_URL="postgresql://frontalier:frontalier@localhost:5436/frontalier?schema=public"

# FW14: the alert list. Unset means confirmation emails are collected in
# memory and never delivered - correct for tests and development. See
# lib/alerts/mailer.ts and the FW28 note in tasks/todo.md.
RESEND_API_KEY=""

# FW25: signs the short-lived token that lets /releve/print render one year.
#
# THE PRINT ROUTE REFUSES THIS PLACEHOLDER BY VALUE, not by hoping nobody
# deploys it - lib/export/print-token.ts compares against it explicitly and
# answers `not_configured`. A signing key everybody has is not a signing key.
#
# Generate a real one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=change-me-local-only-not-for-deployment

{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/copy-fonts.mjs && next start",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/guides",
        "http://localhost:3000/guides/teletravail-frontalier-40-pourcent",
        "http://localhost:3000/guides/geneve"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}

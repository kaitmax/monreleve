{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      },
      "_comment": "R174: three runs, median asserted, floor unchanged at 100. The server and the URL list belong to scripts/lighthouse.mjs, which starts the server itself so it can verify WHOSE it is before anything is measured - a check after autorun reports on numbers it cannot retract."
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ]
      },
      "aggregationMethod": "median"
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}

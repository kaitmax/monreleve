{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/copy-fonts.mjs && next start",
      "url": ["http://localhost:3000/"],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}

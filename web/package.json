{
  "name": "frontalier-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "fonts": "node scripts/copy-fonts.mjs",
    "dev": "node scripts/copy-fonts.mjs && next dev",
    "build": "node scripts/copy-fonts.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"{app,lib}/**/*.scss\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "size": "node scripts/check-budgets.mjs",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.41.0",
    "next": "15.5.25",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "sass": "^1.104.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher"
    ]
  }
}

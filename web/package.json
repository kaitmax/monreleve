{
  "name": "frontalier-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node node_modules/prisma/build/index.js generate",
    "fonts": "node scripts/copy-fonts.mjs",
    "parity:build": "tsc -p tsconfig.parity.json",
    "parity:check": "pnpm parity:build && node scripts/check-format-parity.mjs dist-parity",
    "dev": "node scripts/copy-fonts.mjs && next dev",
    "build": "node scripts/copy-fonts.mjs && next build",
    "db:generate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy",
    "db:reset": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate reset --force",
    "db:seed": "node --env-file-if-exists=.env node_modules/prisma/build/index.js db seed",
    "test:db": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.db.config.ts",
    "build:dev": "node scripts/build-dev-routes.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "eslint . && stylelint \"{app,lib}/**/*.scss\"",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:runtime": "playwright test --config=playwright.runtime.config.ts",
    "test:visual": "node scripts/visual.mjs",
    "test:visual:update": "node scripts/visual.mjs --update",
    "size": "node scripts/check-budgets.mjs",
    "size:dev": "node scripts/build-dev-routes.mjs && node scripts/check-budgets.mjs --dev",
    "lighthouse": "lhci autorun",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=test-results/vitest.json",
    "test:floor": "node scripts/check-suite-floor.mjs",
    "test:a11y": "vitest run lib/ui/react/accessibility tests/unit/pages/accessibility",
    "test:clean-tree": "node scripts/clean-tree-test.mjs",
    "gate": "pnpm test:floor && pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm test:floor -- --report test-results/vitest.json && pnpm build && pnpm size && pnpm parity:check",
    "gate:changed": "node scripts/gate-for-changes.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "lucide-react": "^1.41.0",
    "next": "15.5.25",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "prisma": "7.10.0",
    "sass": "^1.104.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.12"
  }
}
